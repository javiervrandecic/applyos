{
  "name": "applyos",
  "version": "1.2.2",
  "description": "Sistema de busqueda de empleo asistido por IA. Barre portales, analiza el calce leyendo la descripcion completa en vez del titulo, y reporta el embudo etapa por etapa.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sweep": "node scripts/getonbrd-sweep.js",
    "pdf": "node scripts/dashboard-pdf.js",
    "delta": "node scripts/delta.js",
    "escanear": "node herramientas/escanear.js",
    "skills:sync": "node herramientas/sincronizar-skills.js",
    "skills:verificar": "node herramientas/sincronizar-skills.js --verificar",
    "diarizar": "node .claude/skills/applyos-entrevista/scripts/diarizar.js",
    "metricas": "node .claude/skills/applyos-entrevista/scripts/metricas.js",
    "escanear:historial": "node herramientas/escanear.js --historial"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "keywords": [
    "job-search",
    "ai-agents",
    "automation",
    "claude-code",
    "n8n",
    "llm"
  ],
  "license": "MIT"
}
